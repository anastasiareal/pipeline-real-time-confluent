{
  "name": "payments-postgres-cdc",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",
    "database.hostname": "postgres",
    "database.port": "5432",
    "database.user": "postgres",
    "database.password": "__INJETADO_PELO_SCRIPT_A_PARTIR_DO_ENV__",
    "database.dbname": "payments",
    "topic.prefix": "payments",
    "plugin.name": "pgoutput",
    "slot.name": "payments_cdc_slot",
    "publication.name": "payments_publication",
    "publication.autocreate.mode": "filtered",
    "table.include.list": "public.accounts,public.transactions,public.cdc_probe",
    "snapshot.mode": "initial",
    "decimal.handling.mode": "string",
    "time.precision.mode": "isostring",
    "tombstones.on.delete": "true",
    "heartbeat.interval.ms": "10000",
    "transforms": "unwrap",
    "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
    "transforms.unwrap.delete.tombstone.handling.mode": "tombstone",
    "transforms.unwrap.add.fields": "op,lsn"
  }
}
